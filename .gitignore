# --- Python ---
# Virtual environment
venv/
*.pyc
__pycache__/
*.egg-info/
dist/
build/

# --- Sensitive Files ---
# API keys and other secrets
.env
*.env

# --- IDE & OS Files ---
# Mac OS
.DS_Store
# VS Code
.vscode/
# PyCharm / IntelliJ
.idea/

# --- Generated Data Files ---
# Chunking outputs (can be regenerated by run_all_chunkers.py)
chunking/chunks_*.json

# Embedding outputs (can be regenerated by generate_*_embeddings.py)
embedding/*.faiss
embedding/chunks_*.json

# Intermediate extraction data (can be regenerated by scrapers)
extraction/data/scraped_data_*.json

# Raw manual data inputs (knowledge_base.json is kept)
extraction/data/*.html
extraction/data/*.pdf

# --- Streamlit ---
# Streamlit cache and potential config files
.streamlit/

# --- Other ---
# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Packages installed locally (if any, though should be in venv)
*.local

# Log files
*.log